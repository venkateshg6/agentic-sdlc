# Copy to .env; never commit actual credentials.
SHORTENER_API_KEY=replace-with-a-long-random-key
SHORTENER_DB=.runtime/shortener.db
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Set an exact model ID available in your provider account.
LLM_MODEL=
# Optional second OpenAI-compatible provider; never silently fall back to fixtures.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# Pre-pull this image before live validation. No network is given to generated code.
SANDBOX_IMAGE=python:3.12-slim
