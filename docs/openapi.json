  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "CreateUrl": {
        "type": "object",
        "required": [
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "alias": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{4,32}$"
          },
          "ttl_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31536000
          }
        }
      },
      "Url": {
        "type": "object",
        "required": [
          "code",
          "url",
          "created_at",
          "expires_at",
          "disabled",
          "clicks"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "created_at": {
            "type": "number"
          },
          "expires_at": {
            "type": [
              "number",
              "null"
            ]
          },
          "disabled": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "clicks": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      }
